# --- Network ---
NETWORK=devnet                                    # devnet | mainnet

# Comma-separated RPC tuples (R29 multi-RPC client). Format per tuple:
#   <httpUrl>|<wsUrl>|<weight>     (wsUrl + weight optional)
# Highest weight wins as the primary; lower-weight endpoints are fallbacks.
# Add 2-3 endpoints for redundancy in production.
RPC_URLS=https://api.devnet.solana.com|wss://api.devnet.solana.com|100

# --- Crank wallet (D11 — separate keypair per crank) ---
YIELD_CLAIM_CRANK_KEYPAIR_PATH=./data/yield-claim-crank.json

# --- Single-instance lock dir (R30) ---
LOCK_DIR=./data/locks

# --- Programs (vanity program IDs, deployed 2026-04-25) ---
YD_PROGRAM_ID=YLD9EBikcTmVCnVzdx6vuNajrDkp8tyCAgZrqTwmMXF
RWT_ENGINE_PROGRAM_ID=RWT9hgbjHQDj98xP7FYsT5QYp5X32XyK6QfMRmFtARL
DEX_PROGRAM_ID=DEX8LmvJpjefPS1cGS9zWB9ybxN24vNjTTrusBeqyARL
OT_PROGRAM_ID=oWnqbNwmEdjNS5KVbxz8xeuGNjKMd1aiNF89d7qdARL

# --- Proof source — either filesystem (shared with merkle-publisher) or HTTP ---
# At least one of these must be set; PROOF_DIR takes precedence when both are set.
PROOF_DIR=../merkle-publisher/data/proofs
# PROOF_BASE_URL=http://localhost:9464/proofs

# --- OT projects to monitor (comma-separated OT mint base58) ---
OT_PROJECTS=

# --- OT/RWT pools to compound (comma-separated pool addresses) ---
# Optional — if empty, the bot uses the per-OT distributor only and skips compound.
OT_RWT_POOLS=

# --- SPRK OT (used as `ot_mint` for treasury claim across all OT distributors) ---
SPRK_OT_MINT=

# --- RWT mint (sanity check + ATA derivations) ---
RWT_MINT=

# --- Loop pacing (D10 — claim every 30 min by default) ---
CLAIM_INTERVAL_SECS=1800

# --- Compute Budget (claim_yield ~70K, compound ~60K, treasury ~55K → 150K is generous) ---
COMPUTE_UNIT_LIMIT=150000
COMPUTE_UNIT_PRICE_MICROLAMPORTS=10000

# --- Storage / checkpoint (D9) ---
DB_PATH=./data/checkpoint.db

# --- Live submit gate (Substep 13) ---
# When `false` (default), the crank stops at the decision step and logs only.
# Substep 12 bootstrap leaves this off; flip to `true` for E2E live-submit.
SEND_TX=false

# --- Opt-in flows (require SEND_TX=true) ---
# YIELD_CLAIM_ENABLE_LH_DRAIN: drain accumulated RWT from LiquidityHolding.
# Disabled until R20 (RWT_MINT pin migration) lands.
YIELD_CLAIM_ENABLE_LH_DRAIN=false
# YIELD_CLAIM_ENABLE_NEXUS_DEPOSIT: feed USDC from OT Treasury into LiquidityNexus.
# Disabled until LiquidityNexus is provisioned end-to-end.
YIELD_CLAIM_ENABLE_NEXUS_DEPOSIT=false

# --- Logging ---
LOG_LEVEL=info                                    # debug | info | warn | error
