# --- Network ---
NETWORK=devnet                                        # devnet | mainnet
RPC_URL=http://127.0.0.1:8899
RPC_WS_URL=ws://127.0.0.1:8900
# Archival RPC must retain program accounts at historical slots.
# Devnet option: local solana-test-validator --limit-ledger-size=0 (same URL as RPC_URL).
# Mainnet option: Helius/Triton/QuickNode archival tier.
ARCHIVAL_RPC_URL=http://127.0.0.1:8899

# --- Programs ---
YD_PROGRAM_ID=
OT_PROGRAM_ID=
DEX_PROGRAM_ID=

# --- Eligibility threshold ---
# Devnet simplification: flat OT-lamports threshold instead of USD.
# On mainnet replace with an oracle-based filter. 100_000_000 = 100 OT (6 decimals).
MIN_HOLDING_OT_LAMPORTS=100000000

# --- SPRK OT Treasury PDA ---
# Receives non-eligible share + rounding remainder.
SPRK_OT_TREASURY=

# --- Publisher authority ---
# Pubkey that must match config.publish_authority on-chain.
PUBLISHER_PUBKEY=

# --- Timing ---
PUBLISH_INTERVAL_MS=600000                            # 10 min

# --- KMS ---
KMS_PROVIDER=local                                    # local | aws | gcp
KMS_KEY_ID=./local-mock-keypair.json                  # For local: path to keypair JSON. For AWS: KMS key ARN. Gitignored.
AWS_REGION=us-east-1

# --- Storage ---
DB_PATH=./data/merkle-publisher.db
PROOF_DIR=./data/proofs

# --- Logging ---
LOG_LEVEL=info                                        # debug | info | warn | error
