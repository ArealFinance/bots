{
  "name": "areal-bots",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain services for the Areal Finance protocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArealFinance/bots.git"
  },
  "workspaces": [
    "shared",
    "merkle-publisher",
    "pool-rebalancer",
    "revenue-crank",
    "convert-and-fund-crank",
    "yield-claim-crank",
    "nexus-manager"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "shared:build": "npm -w @areal/bots-shared run build",
    "shared:test": "npm -w @areal/bots-shared test",
    "merkle:start": "npm -w merkle-publisher run start",
    "merkle:test": "npm -w merkle-publisher test",
    "rebalancer:start": "npm -w pool-rebalancer run start",
    "revenue:start": "npm -w revenue-crank run start",
    "revenue:test": "npm -w revenue-crank test",
    "convert:start": "npm -w convert-and-fund-crank run start",
    "convert:test": "npm -w convert-and-fund-crank test",
    "claim:start": "npm -w yield-claim-crank run start",
    "claim:test": "npm -w yield-claim-crank test",
    "nexus-manager:start": "npm -w nexus-manager run start",
    "nexus-manager:test": "npm -w nexus-manager test",
    "e2e": "tsx --test .e2e/parity-tests.test.ts .e2e/parity-tx-builders.test.ts .e2e/layer-08-e2e.test.ts .e2e/layer-09-e2e.test.ts .e2e/layer-10-scenario-1-happy-path.test.ts .e2e/discriminator-audit.test.ts"
  }
}
