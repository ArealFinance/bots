# --- Network ---
NETWORK=devnet                                    # devnet | mainnet
RPC_URL=https://api.devnet.solana.com
RPC_WS_URL=wss://api.devnet.solana.com

# --- Crank wallet (D11 — separate keypair per crank) ---
# Local file mode (devnet only). Production: replace with KMS adapter (R3/R6).
CONVERT_FUND_CRANK_KEYPAIR_PATH=./data/convert-fund-crank.json

# --- Programs (vanity program IDs, deployed 2026-04-25) ---
YD_PROGRAM_ID=YLD9EBikcTmVCnVzdx6vuNajrDkp8tyCAgZrqTwmMXF
DEX_PROGRAM_ID=DEX8LmvJpjefPS1cGS9zWB9ybxN24vNjTTrusBeqyARL
RWT_ENGINE_PROGRAM_ID=RWT9hgbjHQDj98xP7FYsT5QYp5X32XyK6QfMRmFtARL
OT_PROGRAM_ID=oWnqbNwmEdjNS5KVbxz8xeuGNjKMd1aiNF89d7qdARL

# --- Token mints + master pool ---
USDC_MINT=
RWT_MINT=
# Master RWT/USDC pool — used for the DEX swap leg of convert_to_rwt
RWT_USDC_POOL=

# --- OT projects to monitor ---
OT_PROJECTS=

# --- Compute Budget (D5 — 300K CU for convert_to_rwt) ---
COMPUTE_UNIT_LIMIT=300000
COMPUTE_UNIT_PRICE_MICROLAMPORTS=10000

# --- Slippage tolerance ---
# 1% — applied to (swap_estimate + mint_estimate) → min_rwt_out.
SLIPPAGE_BPS=100

# --- Storage / checkpoint (D9) ---
DB_PATH=./data/checkpoint.db

# --- Loop pacing (D10 — poll fallback) ---
CHECK_INTERVAL_SECS=300

# --- Min Accumulator USDC balance below which we don't bother converting (1 USDC) ---
MIN_CONVERT_USDC=1000000

# --- Logging ---
LOG_LEVEL=info                                    # debug | info | warn | error
