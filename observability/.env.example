# Areal Observability Stack — Environment Template
#
# Phase 20 — Observability foundation.
#
# Copy to .env and fill in values for your environment.
# All values MUST be empty in this template (.env.example) — bootstrap script
# validates this. Document each variable's purpose in comments.
#
# DO NOT commit .env (only .env.example).
#
# IMPORTANT: bootstrap script `source`s the .env via bash. Values containing
# spaces, quotes, or shell-special characters MUST be quoted with double quotes:
#   GF_AUTH_ANONYMOUS_ORG_NAME="Areal Public"
# Values without spaces can be left unquoted: AREAL_ENV=mainnet

# ---------------------------------------------------------------------------
# Cluster identity
# ---------------------------------------------------------------------------
# AREAL_ENV: deployment environment label, used as Prometheus external label.
#   Values: dev | staging | mainnet
AREAL_ENV=
# AREAL_CLUSTER: cluster identifier within the environment (e.g. "obs-1").
AREAL_CLUSTER=

# ---------------------------------------------------------------------------
# Grafana admin (rotate after first login!)
# ---------------------------------------------------------------------------
# GF_SECURITY_ADMIN_USER: initial admin login. Rotate after first login.
GF_SECURITY_ADMIN_USER=
# GF_SECURITY_ADMIN_PASSWORD: initial admin password. Rotate after first login.
#   MUST be a strong password (>= 16 chars).
GF_SECURITY_ADMIN_PASSWORD=
# GF_SERVER_ROOT_URL: public URL Grafana renders into links/redirects.
#   Example: https://grafana.areal.finance
GF_SERVER_ROOT_URL=

# ---------------------------------------------------------------------------
# Grafana anonymous Viewer (public read-only dashboards)
# ---------------------------------------------------------------------------
# GF_AUTH_ANONYMOUS_ORG_NAME: name of the Grafana org exposed to anonymous users.
#   Example: "Areal Public"
GF_AUTH_ANONYMOUS_ORG_NAME=

# ---------------------------------------------------------------------------
# Prometheus retention (LOCKED — Phase 20 defaults, do not raise without review)
# ---------------------------------------------------------------------------
# PROM_RETENTION_TIME: time-based retention. LOCKED DEFAULT: 15d
PROM_RETENTION_TIME=
# PROM_RETENTION_SIZE: size-based retention cap. LOCKED DEFAULT: 5GB
PROM_RETENTION_SIZE=
# PROM_SCRAPE_INTERVAL: global scrape interval. LOCKED DEFAULT: 15s
PROM_SCRAPE_INTERVAL=

# ---------------------------------------------------------------------------
# Alertmanager → Telegram
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN: bot token from @BotFather (format: 123456:ABC-...).
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID_CRITICAL: chat/channel ID for critical + page alerts.
#   Negative integer for groups/channels (e.g. -1001234567890).
TELEGRAM_CHAT_ID_CRITICAL=
# TELEGRAM_CHAT_ID_WARNING: chat/channel ID for warning alerts.
TELEGRAM_CHAT_ID_WARNING=

# ---------------------------------------------------------------------------
# Blackbox probe targets (HTTPS endpoints to probe via http_2xx module)
# ---------------------------------------------------------------------------
# BLACKBOX_TARGET_PANEL: ops panel URL (e.g. https://panel.areal.finance).
BLACKBOX_TARGET_PANEL=
# BLACKBOX_TARGET_APP: public app URL (e.g. https://app.areal.finance).
BLACKBOX_TARGET_APP=
# BLACKBOX_TARGET_RPC: Solana RPC endpoint URL (HTTPS, getHealth path acceptable).
BLACKBOX_TARGET_RPC=

# ---------------------------------------------------------------------------
# SMTP / Slack receivers — DEFERRED to a later phase.
# Phase 20 ships Telegram-only routing in alertmanager.template.yml.
# ---------------------------------------------------------------------------
