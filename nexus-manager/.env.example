# =============================================================================
# nexus-manager — env vars (Layer 9 Substep 8)
#
# Copy to `.env` and fill in. NO secrets in this template — only placeholders.
# =============================================================================

# ---------- Network --------------------------------------------------------
# Pipe-separated tuple per endpoint: <httpUrl>|<wsUrl>|<weight>
# Multiple endpoints separated by commas — first wins, others used as fallback.
RPC_URLS=https://api.devnet.solana.com|wss://api.devnet.solana.com|10
NETWORK=devnet

# ---------- Manager keypair ------------------------------------------------
# Path to a 64-byte Solana keypair file (`solana-keygen new -o manager.json`).
# Production hardening: replace with KMS reference under R3/R6 (out of scope for
# Layer 9). Bot exits with a structured warning if the on-chain manager equals
# the zero kill-switch sentinel — in that case rotate via DEX
# `update_nexus_manager`.
MANAGER_KEYPAIR_PATH=/path/to/manager.json

# ---------- Single-instance lock ------------------------------------------
# Directory holding the PID-file lock (R30 closure via @areal/bots-shared).
LOCK_DIR=./data/locks

# ---------- DB checkpoint --------------------------------------------------
CHECKPOINT_DB=./data/nexus-manager.db

# ---------- Polling cadence -----------------------------------------------
# 5-min loop per layer-09 architecture §5.1.1.
POLL_INTERVAL_SEC=300

# ---------- Decision thresholds -------------------------------------------
# Base unit thresholds (USDC = 1e6 lamports per token, RWT = 1e9 lamports).
# 1 USDC minimum-rebalance threshold.
MIN_REBALANCE_USDC=1000000
# Target 50/50 USDC / RWT mix in the Nexus's idle balance (5000 = 50%).
LP_TARGET_RATIO_BPS=5000
# Rebalance trigger: drift > 5% (500 bps) from target.
LP_REBALANCE_TRIGGER_BPS=500
# Per-pool concentration cap — bot will not deploy more than 50% of idle
# capital into a single pool.
MAX_POOL_CONCENTRATION_BPS=5000

# ---------- Programs / mints ----------------------------------------------
# Vanity DEX program ID (Layer 1-7 deploy 2026-04-25, project_layer1to7_deployed).
DEX_PROGRAM_ID=DEX8LmvJpjefPS1cGS9zWB9ybxN24vNjTTrusBeqyARL
USDC_MINT=
RWT_MINT=FUQX2AepBoun3hFQjoXcfbX5aGRLxfACx1sAqCC63i5

# Comma-separated managed pools (PoolState PDAs). Empty = no managed pools
# (bot idles, useful for staging rollout).
NEXUS_MANAGED_POOLS=

# ---------- Logging --------------------------------------------------------
LOG_LEVEL=info
